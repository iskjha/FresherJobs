# Copy to .env (never commit .env).

# --- MongoDB -----------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/fresher_jobs   Atlas: mongodb+srv://user:pass@cluster/fresher_jobs
MONGODB_URI=mongodb://127.0.0.1:27017/fresher_jobs

# --- API server --------------------------------------------------------------
PORT=4000
# Daily pipeline run inside the API process (node-cron syntax + timezone).
ENABLE_CRON=true
CRON_SCHEDULE=30 6 * * *
CRON_TZ=Asia/Kolkata
# Enables POST /api/admin/refresh and GET /api/admin/status (header x-admin-token).
ADMIN_TOKEN=
# Only needed if the frontend is hosted on a different origin.
# CORS_ORIGIN=https://your-frontend.example

# --- LLM tagging (any OpenAI-compatible endpoint, incl. Azure OpenAI …/openai/v1/) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROFILE_MODEL=gpt-5.4

# Optional: list prices per 1M tokens used for the cost report.
# LLM_PRICE_INPUT_PER_M=2.5
# LLM_PRICE_CACHED_INPUT_PER_M=0.25
# LLM_PRICE_OUTPUT_PER_M=15
# Refuse to write below this many fresher jobs (must be at least 200).
# MIN_PUBLISH_JOBS=200

# --- Tests -------------------------------------------------------------------
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
